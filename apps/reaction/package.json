    "@reactioncommerce/api-plugin-email-templates": "file:../../packages/api-plugin-email-templates",
    "@reactioncommerce/api-plugin-files": "file:../../packages/api-plugin-files",
    "@reactioncommerce/api-plugin-fulfillment": "file:../../packages/api-plugin-fulfillment",
    "@reactioncommerce/api-plugin-fulfillment-type-shipping": "file:../../packages/api-plugin-fulfillment-type-shipping",
