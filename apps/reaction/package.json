    "@reactioncommerce/api-plugin-system-information": "file:../../packages/api-plugin-system-information",
    "@reactioncommerce/api-plugin-tags": "file:../../packages/api-plugin-tags",
    "@reactioncommerce/api-plugin-taxes": "file:../../packages/api-plugin-taxes",
    "@reactioncommerce/api-plugin-taxes-flat-rate": "file:../../packages/api-plugin-taxes-flat-rate",
    "@reactioncommerce/api-plugin-translations": "file:../../packages/api-plugin-translations",
